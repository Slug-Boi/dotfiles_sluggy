# ─────────────────────────────────────────────────────────────────────────────
# Font
# ─────────────────────────────────────────────────────────────────────────────

font-family = IosevkaTerm Nerd Font
font-size = 14

# ─────────────────────────────────────────────────────────────────────────────
# Window
# ─────────────────────────────────────────────────────────────────────────────

background-opacity = 0.65
background-blur = 55
window-padding-x = 5
window-padding-y = 3
confirm-close-surface = false

# Makes the titlebar match your background color (cleaner look)
macos-titlebar-style = tabs
macos-titlebar-style = transparent

# ─────────────────────────────────────────────────────────────────────────────
# Keyboard
# ─────────────────────────────────────────────────────────────────────────────

# Enable kitty keyboard protocol (equivalent to use-kitty-keyboard-protocol)
term = xterm-ghostty

# Use option key as alt (equivalent to option-as-alt = both)
macos-option-as-alt = true

# ─────────────────────────────────────────────────────────────────────────────
# Colors
# ─────────────────────────────────────────────────────────────────────────────

background = 0c0c0c
foreground = d9d9d9
selection-background = 343434
selection-foreground = ffffff
cursor-color = b9bcba

# Normal colors
palette = 0=#1a1a1a
palette = 1=#f4005f
palette = 2=#98e024
palette = 3=#fd971f
palette = 4=#9d65ff
palette = 5=#f4005f
palette = 6=#58d1eb
palette = 7=#c4c5b5

# Bright colors
palette = 8=#625e4c
palette = 9=#f4005f
palette = 10=#98e024
palette = 11=#e0d561
palette = 12=#9d65ff
palette = 13=#f4005f
palette = 14=#58d1eb
palette = 15=#f6f6ef

# ─────────────────────────────────────────────────────────────────────────────
# Keybindings
# ─────────────────────────────────────────────────────────────────────────────

keybind = super+q=quit
